# ==============================================================================
# CapsLoc Environment Configuration Matrix
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL="postgresql://user:password@localhost:5432/capsloc_dev?schema=public"

# Docker Compose Network:
# DATABASE_URL="postgresql://capsloc_admin:capsloc_secure_password_2026@postgres:5432/capsloc_prod?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Secrets (Dual-Token Security)
# ------------------------------------------------------------------------------
# Provide cryptographically random strings for production deployments
JWT_ACCESS_SECRET="capsloc_super_secret_access_key_dev_12345"
JWT_REFRESH_SECRET="capsloc_super_secret_refresh_key_dev_67890"

# ------------------------------------------------------------------------------
# 3. Server Networking & CORS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Origin URL of the client application for CORS credentialed requests
CLIENT_URL="http://localhost:5173"
# In Docker Compose (via Nginx reverse proxy):
# CLIENT_URL="http://localhost"

# ------------------------------------------------------------------------------
# 4. Docker Compose Variables (Optional)
# ------------------------------------------------------------------------------
POSTGRES_USER=capsloc_admin
POSTGRES_PASSWORD=capsloc_secure_password_2026
POSTGRES_DB=capsloc_prod
POSTGRES_PORT=5432
CLIENT_PORT=80
